#!/usr/bin/env bash
# Dotfiles management CLI

DOTS_DIR="${PWCCA_DOTS_DIR:-$HOME/.pwcca-dots}"
CMD_DIR="$DOTS_DIR/.data/pwcca-cli/commands"

cmd="${1:-help}"
[[ "$cmd" == "--help" || "$cmd" == "-h" ]] && cmd="help"
shift 2>/dev/null || true

cmd_file="$CMD_DIR/$cmd.sh"
if [[ -f "$cmd_file" ]]; then
    # Run inside a function so 'local' and 'return' work in sourced files
    _pwcca_run() {
        source "$cmd_file" "$@"
    }
    _pwcca_run "$@"
else
    echo "unknown command '$cmd'"
    echo "Run 'pwcca help' for usage information."
    exit 1
fi
