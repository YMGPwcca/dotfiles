#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:$PATH"

PLUGIN_REPO="https://github.com/virtcode/hypr-dynamic-cursors"
HYPRLAND_REPO="https://github.com/hyprwm/Hyprland"
PLUGIN_DIR="${PLUGIN_DIR:-$HOME/.local/share/hyprplugins/hypr-dynamic-cursors}"
HEADERS_ROOT="${HEADERS_ROOT:-$HOME/.local/share/hyprpm/headersRoot}"

log() {
    printf '[hypr-dynamic-cursors] %s\n' "$*"
}

need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf '[hypr-dynamic-cursors] missing dependency: %s\n' "$1" >&2
        exit 1
    fi
}

hypr_version_text() {
    Hyprland --version 2>/dev/null || hyprctl version 2>/dev/null
}

hyprland_commit() {
    sed -n 's/.* commit \([0-9a-f]\{40\}\).*/\1/p' | head -n1
}

hyprland_abi() {
    sed -n 's/^Version ABI string: //p' | head -n1
}

plugin_commit_for_hyprland() {
    local commit="$1"
    local pins
    if pins="$(git -C "$PLUGIN_DIR" show origin/main:hyprpm.toml 2>/dev/null)"; then
        :
    else
        pins="$(cat "$PLUGIN_DIR/hyprpm.toml")"
    fi

    printf '%s\n' "$pins" |
    awk -v commit="$commit" '
        index($0, "\"" commit "\"") {
            line = $0
            sub(/^.*\["[0-9a-f]+", *"/, "", line)
            sub(/".*$/, "", line)
            print line
            exit
        }
    '
}

reload_running_sessions() {
    local runtime_dir="/run/user/$(id -u)/hypr"

    if [[ ! -d "$runtime_dir" ]]; then
        log "no running Hyprland session found; plugin will load on next session start"
        return 0
    fi

    local loaded=0
    local sigdir
    for sigdir in "$runtime_dir"/*; do
        [[ -S "$sigdir/.socket.sock" ]] || continue
        HYPRLAND_INSTANCE_SIGNATURE="$(basename "$sigdir")" hyprctl reload >/dev/null 2>&1 || true
        if HYPRLAND_INSTANCE_SIGNATURE="$(basename "$sigdir")" hyprctl plugin list 2>/dev/null | grep -q 'Plugin dynamic-cursors'; then
            loaded=1
        fi
    done

    if [[ "$loaded" == 1 ]]; then
        log "reloaded running Hyprland session"
    else
        log "rebuilt plugin, but no running session loaded it yet"
    fi
}

main() {
    need git
    need cmake
    need make
    need g++
    need pkg-config
    need cpio

    local version_text commit abi
    version_text="$(hypr_version_text)"
    commit="$(printf '%s\n' "$version_text" | hyprland_commit)"
    abi="$(printf '%s\n' "$version_text" | hyprland_abi)"

    if [[ -z "$commit" || -z "$abi" ]]; then
        printf '[hypr-dynamic-cursors] could not read Hyprland commit/ABI\n%s\n' "$version_text" >&2
        exit 1
    fi

    log "target Hyprland ABI: $abi"

    mkdir -p "$(dirname "$PLUGIN_DIR")" "$(dirname "$HEADERS_ROOT")"

    if [[ ! -d "$PLUGIN_DIR/.git" ]]; then
        log "cloning plugin"
        git clone "$PLUGIN_REPO" "$PLUGIN_DIR"
    else
        log "updating plugin metadata"
        git -C "$PLUGIN_DIR" fetch --quiet origin
    fi

    local plugin_commit
    plugin_commit="$(plugin_commit_for_hyprland "$commit")"
    if [[ -z "$plugin_commit" ]]; then
        printf '[hypr-dynamic-cursors] no pinned plugin commit for Hyprland commit %s\n' "$commit" >&2
        exit 1
    fi

    local workdir hypr_src
    workdir="$(mktemp -d)"
    trap "rm -rf '$workdir'" EXIT
    hypr_src="$workdir/Hyprland"

    log "preparing Hyprland headers"
    git clone --quiet --filter=blob:none "$HYPRLAND_REPO" "$hypr_src"
    git -C "$hypr_src" checkout --quiet "$commit"
    git -C "$hypr_src" submodule update --quiet --init --recursive
    cmake -S "$hypr_src" -B "$hypr_src/build" \
        -DCMAKE_INSTALL_PREFIX="$HEADERS_ROOT" \
        -DCMAKE_BUILD_TYPE=Release >/dev/null
    make -C "$hypr_src" installheaders PREFIX="$HEADERS_ROOT" >/dev/null

    log "building plugin commit $plugin_commit"
    git -C "$PLUGIN_DIR" checkout --quiet "$plugin_commit"
    rm -rf "$PLUGIN_DIR/out"
    PKG_CONFIG_PATH="$HEADERS_ROOT/share/pkgconfig:${PKG_CONFIG_PATH:-}" make -C "$PLUGIN_DIR" all >/dev/null

    if ! grep -aFq "$commit" "$PLUGIN_DIR/out/dynamic-cursors.so"; then
        printf '[hypr-dynamic-cursors] rebuilt plugin does not contain expected Hyprland commit: %s\n' "$commit" >&2
        exit 1
    fi

    log "rebuilt successfully"
    reload_running_sessions
}

main "$@"
